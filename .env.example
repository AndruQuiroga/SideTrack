# Local development settings for docker compose. Copy to .env and fill in.
# Every variable here is read by code; see config/ENVIRONMENT.md for details.
# On Stache-Rack, secrets come from Swarm secrets instead (deploy/README.md).

# --- Postgres (db container) ---
POSTGRES_DB=sidetrack
POSTGRES_USER=sidetrack
POSTGRES_PASSWORD=sidetrack

# --- API ---
SIDETRACK_ENV=development
DATABASE_URL=postgresql+psycopg://sidetrack:sidetrack@db:5432/sidetrack
# One token per API client (ADR 0009); they must differ. Placeholders for local use only.
SIDETRACK_WEB_API_TOKEN=local-web-token-change-me
SIDETRACK_BOT_API_TOKEN=local-bot-token-change-me
# Empty in development: the API generates one per process.
SIDETRACK_LINK_SECRET=
LASTFM_API_KEY=
LASTFM_API_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SIDETRACK_MUSICBRAINZ_APP_NAME=Sidetrack/0.1 (you@example.com)

# --- Bot and web server -> API ---
SIDETRACK_API_BASE_URL=http://api:8000

# --- Discord (bot and web sign-in) ---
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
SIDETRACK_NOMINATIONS_FORUM_ID=
SIDETRACK_ADMIN_ROLE_IDS=
# true only if the privileged Server Members intent is enabled for the bot application.
DISCORD_MEMBERS_INTENT=false

# --- Web ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string
