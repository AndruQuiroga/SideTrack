# Install as /etc/sidetrack/backup.env, mode 0600 root. Heartbeat URLs contain tokens.
SIDETRACK_BACKUP_DIR=/srv/sidetrack/backups
# The mount `findmnt -n -o TARGET -T "$SIDETRACK_BACKUP_DIR"` must report.
SIDETRACK_BACKUP_MOUNT=
# SSH destination of the receiver on the second host, for example sidetrack-backup@docker-0.
SIDETRACK_COPY_TARGET=
SIDETRACK_COPY_KEY=/etc/sidetrack/backup-copy-key
# Uptime Kuma push URLs. Each job calls its URL only after succeeding.
SIDETRACK_BACKUP_HEARTBEAT_URL=
SIDETRACK_COPY_HEARTBEAT_URL=
SIDETRACK_RESTORE_HEARTBEAT_URL=
